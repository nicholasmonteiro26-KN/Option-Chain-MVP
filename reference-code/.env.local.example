# Live TradeSmart data for the dev server (npx ng serve). Copy this file to .env.local and fill it in.
# .env.local is git-ignored. Only the Node dev-server proxy (proxy.conf.mjs) reads it; the Secret Key never reaches
# the browser or the bundle, and the App Key is served by the proxy (in the /auth/start redirect), not bundled.
#
# Before you start, on the TradeSmart API dashboard (TradeSmart web app: Tools -> API):
#   - the Redirect URL on the dashboard must be exactly http://localhost:4200/auth/callback
#   - TradeSmart's v2 API only accepts calls from the static IP registered there: this machine's public IP must match.

# TradeSmart's Kambala REST base, the full path up to the endpoint name (e.g. https://<host>/NorenWClientAPIv2).
KAMBALA_REST_URL=
# TradeSmart's Kambala WebSocket URL (e.g. wss://<host>/NorenWSAPI/).
KAMBALA_WS_URL=
# App Key from Tools -> API in the TradeSmart web app. Sent as the OAuth client_id.
TRADESMART_APP_KEY=
# Secret Key from Tools -> API in the TradeSmart web app. Used only by the proxy for the GenAcsTok checksum.
# Secret: never commit or share it.
TRADESMART_SECRET_KEY=
# Optional: the OAuth authorize page. Default: https://v2api.tradesmartonline.in/OAuthlogin/authorize/oauth
# TRADESMART_AUTHORIZE_URL=
